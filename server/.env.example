# Supabase — Project Settings → API
# Bare project URL, no trailing slash, no /rest/v1/ path
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public/anon key — used for user-facing auth endpoints (signup, login, logout)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Secret service-role key — bypasses RLS; used for PostgREST DB calls and token validation.
# NEVER expose in a browser or commit to version control.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Server port (optional, defaults to 3000)
PORT=3000

# Path to the PDF template (optional, defaults to ./templates/notice-of-small-claim-september-2025.pdf)
PDF_TEMPLATE_PATH=./templates/notice-of-small-claim-september-2025.pdf
